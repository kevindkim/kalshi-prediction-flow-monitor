# Kalshi API Credentials
KALSHI_API_KEY_ID=your-key-id
KALSHI_PRIVATE_KEY_PATH=./kalshi-private-key.pem

# ---------------------------------------------------------------------------
# Schwab put spread monitor (npm run spreads -- help)
# ---------------------------------------------------------------------------
# From developer.schwab.com → your "Trader API - Individual" app
SCHWAB_APP_KEY=your-app-key
SCHWAB_APP_SECRET=your-app-secret
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182/callback
SCHWAB_TOKEN_PATH=./schwab-tokens.json
# Optional: pick one account when several are linked (last digits are fine)
# SCHWAB_ACCOUNT_NUMBER=1234

# Up to ~10 names to scan
SPREAD_WATCHLIST=SPY,QQQ,AAPL,MSFT,NVDA,AMZN,GOOGL,META,AMD,IWM
# Strategy knobs (defaults shown; see docs/put-spread-strategy-research.md)
# SPREAD_MIN_DTE=30
# SPREAD_MAX_DTE=50
# SPREAD_MANAGE_DTE=21
# SPREAD_MIN_SHORT_DELTA=0.16
# SPREAD_MAX_SHORT_DELTA=0.30
# SPREAD_MIN_WIDTH=2.5
# SPREAD_MAX_WIDTH=10
# SPREAD_MIN_CREDIT_TO_WIDTH=0.20
# SPREAD_GOOD_CREDIT_TO_WIDTH=0.33
# SPREAD_PROFIT_TARGET_PCT=0.50
# SPREAD_PROFIT_PROMPT_MIN_PCT=0.50
# SPREAD_PROFIT_PROMPT_MAX_PCT=0.65
# SPREAD_STOP_LOSS_MULTIPLE=2.0
# SPREAD_RISK_PER_TRADE_PCT=0.02
# SPREAD_GOOD_PREMIUM_MIN_SCORE=65
# SPREAD_ALERT_COOLDOWN_HOURS=20
# SPREAD_MONITOR_INTERVAL_MIN=15
# SPREAD_SCAN_INTERVAL_MIN=60
# SPREAD_FILL_WAIT_MIN=10

# Earnings dates (Schwab has no earnings endpoint). Either inline, a JSON file, or Finnhub.
# SPREAD_EARNINGS=AAPL=2026-10-29,MSFT=2026-10-28
# SPREAD_EARNINGS_JSON=./earnings.json
# FINNHUB_API_KEY=

# Email prompts: Gmail app password (same variable names as OptionsEmailer) or any SMTP server
EMAIL_USER=you@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
ALERT_EMAIL_TO=you@gmail.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Text prompts: Twilio, or a free carrier email-to-SMS gateway (Verizon vtext.com, AT&T txt.att.net, T-Mobile tmomail.net)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+15550000000
# ALERT_SMS_TO=+15551234567
# ALERT_SMS_GATEWAY=5551234567@vtext.com
